@@ -229,6 +229,30 @@ _tts_pipeline_lock = asyncio.Lock()
 _STREAM_END = object()
 
 
+class _GuardedStreamingResponse(StreamingResponse):
+    """[AMADEUS] Quand le client coupe la connexion (phrase interrompue), Starlette lève
+    ClientDisconnect sans fermer le générateur ni lancer la tâche de fond : le verrou du
+    pipeline restait pris jusqu'au passage du ramasse-miettes (parfois plusieurs minutes),
+    et toutes les phrases suivantes attendaient. Ici le nettoyage est garanti."""
+
+    def __init__(self, *args, on_close=None, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._on_close = on_close
+
+    async def __call__(self, scope, receive, send):
+        try:
+            await super().__call__(scope, receive, send)
+        finally:
+            aclose = getattr(self.body_iterator, "aclose", None)
+            try:
+                if aclose is not None:
+                    await _await_shielded(aclose())
+            except Exception:
+                pass
+            if self._on_close is not None:
+                await self._on_close()
+
+
 async def _await_shielded(awaitable):
     task = asyncio.ensure_future(awaitable)
     try:
