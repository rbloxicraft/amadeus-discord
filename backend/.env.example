# ============================================================
#  Configuration d'Amadeus
#  Copie ce fichier en « .env » (l'installateur le fait pour toi et te demande
#  tes clés). Ne partage jamais ton .env : il contient tes clés API.
# ============================================================

# === Cerveau principal (obligatoire) ===
# Clé d'API d'une IA compatible OpenAI. Recommandé : Z.ai (https://z.ai), le plus
# fidèle au personnage dans nos essais. Autres fournisseurs compatibles : changer
# l'adresse et le nom du modèle ci-dessous (voir leur documentation).
LLM_API_KEY=colle-ta-cle-ici
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-5.3
# Coupe la « réflexion » des modèles qui en ont une : ~2 s au lieu de 10+ avant le
# premier mot (ignoré par les API qui ne connaissent pas ce réglage)
LLM_DISABLE_THINKING=true

# === Cerveau rapide : Groq (facultatif, gratuit) ===
# Clé gratuite sur https://console.groq.com — choix du cerveau dans l'interface
# (Réglages > Cerveau). Quota gratuit dépassé → le message part sur le cerveau principal.
# Avec une clé Groq seule (sans cerveau principal), mets BRAIN=gptoss.
GROQ_API_KEY=
# === Cerveau DeepSeek (facultatif, payant mais très peu cher) ===
# Clé sur https://platform.deepseek.com : 1re phrase en ~1 s, sans quota par minute.
# Sert aussi de secours quand le quota gratuit de Groq est épuisé.
DEEPSEEK_API_KEY=
# Cerveau au tout premier lancement : main (principal), gptoss (rapide) ou deepseek
BRAIN=main

# === Voix (TTS) ===
# Serveur GPT-SoVITS local (voix de Kurisu)
TTS_GPTSOVITS_URL=http://127.0.0.1:9880
# Voix de secours (edge-tts) si GPT-SoVITS est éteint
TTS_FALLBACK_VOICE=ja-JP-NanamiNeural
# Streaming : 3 = régulier, sans blanc en pleine phrase (conseillé) ; 0 = désactivé
TTS_STREAMING_MODE=3
# Stabilité (plus bas = moins de mots avalés, mais plus monotone)
TTS_TEMPERATURE=0.7
TTS_TOP_K=5
TTS_TOP_P=0.9
# Volume cible (dB) : toutes les émotions sont ramenées au même niveau
TTS_LOUDNESS_DB=-16
# Référence neutre : par défaut celle de l'installation (tts-server/kurisu/emotions/refs.json).
# Pour en essayer une autre : chemin du .wav + sa transcription exacte.
# TTS_REF_AUDIO=../tts-server/kurisu/ref.wav
# TTS_REF_TEXT=

# === Oreilles (STT, Whisper) ===
# large-v3-turbo = rapide et précis (conseillé) ; medium ; small (machines modestes)
STT_MODEL=large-v3-turbo
# auto = carte graphique si possible, sinon processeur
STT_DEVICE=auto
# auto = détection de la langue ; fr = plus fiable si tu parles toujours français
STT_LANGUAGE=fr
# Charge Whisper au démarrage (sinon ~10 s d'attente au premier appui micro)
STT_PRELOAD=true

# === Divers ===
DATA_DIR=../data
BACKEND_PORT=8643
